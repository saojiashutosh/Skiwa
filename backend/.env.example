# ── Django ──────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# ── Database (Neon PostgreSQL in production) ────────────
# Local default falls back to sqlite if unset
DATABASE_URL=postgres://skiwaa:skiwaa@localhost:5432/skiwaa

# ── Redis ───────────────────────────────────────────────
# Leave unset for local dev (uses in-memory cache + inline Celery tasks).
# Set it when Redis is running to enable real caching + background workers.
#REDIS_URL=redis://localhost:6379/0

# ── CORS ────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Frontend (used in transactional email links) ────────
FRONTEND_URL=http://localhost:3000

# ── JWT ─────────────────────────────────────────────────
JWT_ACCESS_LIFETIME_MINUTES=30
JWT_REFRESH_LIFETIME_DAYS=7

# ── Cloudinary ──────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Razorpay ────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxx

# ── Email ───────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=SKIWAA <no-reply@skiwaa.in>
